{
  "name": "nook",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-production.mjs",
    "dev:dev": "node scripts/vite-dev.mjs",
    "build": "tsc --noEmit && node scripts/vite-production.mjs build",
    "build:dev": "tsc --noEmit && node scripts/vite-dev.mjs build",
    "build:standalone": "tsc --noEmit && node scripts/vite-standalone.mjs build",
    "preview:dev": "vite preview --outDir dist-dev --host 127.0.0.1 --port 4174 --strictPort",
    "test:frontend-output-isolation": "node --test tests/frontend-output-isolation.test.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test:shelf-trace": "node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/shelf-trace.test.ts",
    "check:dev-previews": "tsc --noEmit --project tsconfig.dev.json",
    "test:compact-metrics": "node --experimental-strip-types --test tests/compact-metrics.test.ts && node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/compact-usage.test.ts && node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/compact-production.test.ts",
    "test:compact-rotation-ui": "node scripts/test-settings-simulator-layout.mjs compact-rotation-fixture.html",
    "test:dev-simulator": "node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/dev-simulator-ui.test.ts && node scripts/test-settings-simulator-layout.mjs",
    "test:dev-hook-relay": "cargo test -p nook-hook --no-default-features --features nook-dev-relay --bin nook-hook-dev && node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/real-hook-event-state.test.ts tests/island-autoclose.test.ts",
    "test:dev-hook-ipc": "cargo test -p nook-hook --no-default-features --features nook-dev-relay --test dev_relay",
    "test:dev-build-artifact": "node scripts/test-dev-build-artifact.mjs",
    "test:codex-quota-view": "node --experimental-strip-types --experimental-loader ./tests/resolve-ts-loader.mjs --test tests/codex-quota-view.test.ts tests/quota-layout-smoke.test.ts && node scripts/test-settings-simulator-layout.mjs home-usage-layout.html",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "fake-session": "node scripts/fake-session.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:stage": "node scripts/shot.mjs --set",
    "shots:check": "node scripts/shots.mjs --check",
    "shots:import": "node scripts/import-shot.mjs",
    "shots:list": "node scripts/shots.mjs --list",
    "tauri": "tauri",
    "tauri:build:dev": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-dev.ps1",
    "tauri:build:standalone": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone.ps1",
    "tauri:installer:standalone": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone-installer.ps1",
    "predev": "cargo build --release -p nook-hook",
    "prebuild": "cargo build --release -p nook-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
